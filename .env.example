# TheDadBot never reads private keys from .env.
# RPC/API credentials only. Keep the real .env private and gitignored.

THEDADBOT_AGENT_PORT=47831
THEDADBOT_DASHBOARD_PORT=4173

# Exact browser origins allowed to call the loopback local agent.
# Keep this localhost-only while the unlocked agent exposes write-capable routes.
# Do NOT add the hosted Vercel origin until a separate local write-auth/approval boundary is enabled.
THEDADBOT_DASHBOARD_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# READ / quorum endpoints. Comma-separated. These are used to independently
# resolve chain/drop state and benchmark endpoint freshness.
ETHEREUM_RPCS=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com
BASE_RPCS=https://mainnet.base.org,https://base-rpc.publicnode.com
ROBINHOOD_RPCS=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPCS=https://rpc.testnet.chain.robinhood.com
ARBITRUM_RPCS=
OPTIMISM_RPCS=
POLYGON_RPCS=
ZORA_RPCS=

# OPTIONAL Race Mode WRITE endpoints. These are local-only and are never used as
# state authority just because they are fast. Put paid/private/direct-sequencer
# endpoints here when you have them. They may contain API credentials, so NEVER
# commit the real values and NEVER expose them through VITE_* / Vercel env.
# If a chain's *_BROADCAST_RPCS is empty, Race Mode falls back to healthy *_RPCS.
ETHEREUM_BROADCAST_RPCS=
BASE_BROADCAST_RPCS=
ROBINHOOD_BROADCAST_RPCS=
ROBINHOOD_TESTNET_BROADCAST_RPCS=
ARBITRUM_BROADCAST_RPCS=
OPTIMISM_BROADCAST_RPCS=
POLYGON_BROADCAST_RPCS=
ZORA_BROADCAST_RPCS=

# OpenSea public REST key for the LOCAL agent / CLI only.
# Never expose this as a VITE_* variable or configure it in the hosted frontend.
OPENSEA_API_KEY=

# Optional short-lived wallet JWT for eligibility checks, LOCAL only.
# Generate it with OpenSea auth/CLI; never commit it or expose it to Vite.
OPENSEA_WALLET_JWT=

# Optional PUBLIC Vite build setting. The dashboard validates this as loopback-only.
# You normally do not need to set it because this is the default.
# VITE_AGENT_URL=http://127.0.0.1:47831
