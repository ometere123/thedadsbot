# TheDadBot never reads private keys from .env.
# RPC/API credentials only. Keep the real .env private.

THEDADBOT_AGENT_PORT=47831
THEDADBOT_DASHBOARD_PORT=4173

# Exact browser origins allowed to call the loopback local agent.
# After Vercel deployment, append your exact production origin locally, for example:
# THEDADBOT_DASHBOARD_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://your-project.vercel.app
THEDADBOT_DASHBOARD_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Comma-separated endpoints. Add paid/private endpoints locally when available.
ETHEREUM_RPCS=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com
BASE_RPCS=https://mainnet.base.org,https://base-rpc.publicnode.com
ROBINHOOD_RPCS=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPCS=https://rpc.testnet.chain.robinhood.com

# OpenSea public REST key for the LOCAL agent / CLI only.
# Never expose this as a VITE_* variable or configure it in the hosted frontend.
OPENSEA_API_KEY=

# Optional short-lived wallet JWT for eligibility checks, LOCAL only.
# Generate it with OpenSea auth/CLI; never commit it or expose it to Vite.
OPENSEA_WALLET_JWT=

# Optional PUBLIC Vite build setting. The dashboard validates this as loopback-only.
# You normally do not need to set it because this is the default.
# VITE_AGENT_URL=http://127.0.0.1:47831
