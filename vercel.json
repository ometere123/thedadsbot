{
  "version": 2,
  "public": false,
  "rewrites": [
    { "source": "/", "destination": "/apps/dashboard/index.html" },
    { "source": "/app.js", "destination": "/apps/dashboard/app.js" },
    { "source": "/styles.css", "destination": "/apps/dashboard/styles.css" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
