{
  "name": "thedadbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open multi-chain NFT mint operations platform: dashboard, local agent and CLI sharing one safety core.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "npm test && node scripts/secret-scan.js && node scripts/repo-check.js",
    "cli": "node packages/cli/src/index.js",
    "agent": "node packages/agent/src/server.js",
    "dashboard": "vite --config apps/dashboard/vite.config.js",
    "dashboard:build": "vite build --config apps/dashboard/vite.config.js",
    "dashboard:preview": "vite preview --config apps/dashboard/vite.config.js",
    "race:bench": "node scripts/race-benchmark.js",
    "doctor": "node packages/cli/src/index.js doctor"
  },
  "dependencies": {
    "@opensea/sdk": "^12.0.1",
    "ethers": "^6.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
