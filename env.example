# TheDadBot never reads private keys from .env.
# RPC/API credentials only. Keep the real .env private.

THEDADBOT_AGENT_PORT=47831
THEDADBOT_DASHBOARD_PORT=4173

# Comma-separated endpoints. Add paid/private endpoints locally when available.
ETHEREUM_RPCS=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com
BASE_RPCS=https://mainnet.base.org,https://base-rpc.publicnode.com
ROBINHOOD_RPCS=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPCS=https://rpc.testnet.chain.robinhood.com

# OpenSea public REST key. The CLI can also request an instant free-tier key.
OPENSEA_API_KEY=

# Optional short-lived wallet JWT for eligibility checks.
# Generate it with OpenSea auth/CLI; never commit it.
OPENSEA_WALLET_JWT=
